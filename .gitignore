# MKIV 学术情报图谱引擎 — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
*.spec.bak

# Virtual environments
venv/
.env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project data (runtime generated)
data/01_raw/
data/02_analyzed/
data/03_cleaned/
data/output/
data/input/*
!data/input/.gitkeep
data/import/

# 合成演示数据要提交 (JOSS 审稿人需要)，但其运行产物不提交
data/sample/_run/

# Config with secrets
config/config.yaml
!config/config.example.yaml

# Local models (downloaded at runtime, ~470MB)
models/

# Logs
*.log

# PyInstaller
dist/
build/
*.spec.bak

# Docker
docker-compose.override.yml

# Sentinels
.mkiv_gui_initialized
.claude/

# 本地上传暂存目录（手工同步用，不属于仓库内容）
上传专用/

# 本地工具链说明（仅本地留存，不进仓库）
AI署名机制说明.md
